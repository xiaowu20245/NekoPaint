{
  "$schema": "https://nekopaint.github.io/schema/design-tokens-v1.json",
  "meta": {
    "name": "NekoPaint Design System Tokens",
    "version": "1.0.0",
    "platform": "Android Jetpack Compose (Material 3)",
    "updatedAt": "2026-11-08",
    "notes": "Supports Light, Dark, and Android 12+ Dynamic Color. Semantic status colors (success, warning, danger, info) are harmonized and color-blind safe (always paired with distinct icons/shapes)."
  },
  "color": {
    "brand": {
      "light": {
        "primary": "#4A63E7",
        "onPrimary": "#FFFFFF",
        "primaryContainer": "#DDE1FF",
        "onPrimaryContainer": "#001453",
        "secondary": "#545D7E",
        "onSecondary": "#FFFFFF",
        "secondaryContainer": "#DAE1FF",
        "onSecondaryContainer": "#101A37",
        "tertiary": "#4F5B7A",
        "onTertiary": "#FFFFFF",
        "tertiaryContainer": "#DDE3F5",
        "onTertiaryContainer": "#111A2E"
      },
      "dark": {
        "primary": "#B8C4FF",
        "onPrimary": "#132D9E",
        "primaryContainer": "#3049CE",
        "onPrimaryContainer": "#DDE1FF",
        "secondary": "#BCC5EB",
        "onSecondary": "#262F4D",
        "secondaryContainer": "#3C4665",
        "onSecondaryContainer": "#DAE1FF",
        "tertiary": "#B7C4E7",
        "onTertiary": "#212D4A",
        "tertiaryContainer": "#374362",
        "onTertiaryContainer": "#DDE3F5"
      }
    },
    "surface": {
      "light": {
        "background": "#FAF8FF",
        "onBackground": "#1A1B21",
        "surface": "#FAF8FF",
        "onSurface": "#1A1B21",
        "surfaceVariant": "#E2E1EC",
        "onSurfaceVariant": "#45464F",
        "surfaceContainerLowest": "#FFFFFF",
        "surfaceContainerLow": "#F4F2FA",
        "surfaceContainer": "#EEEDF4",
        "surfaceContainerHigh": "#E8E7EF",
        "surfaceContainerHighest": "#E2E1E9",
        "outline": "#767680",
        "outlineVariant": "#C6C5D0"
      },
      "dark": {
        "background": "#121318",
        "onBackground": "#E3E1E9",
        "surface": "#121318",
        "onSurface": "#E3E1E9",
        "surfaceVariant": "#45464F",
        "onSurfaceVariant": "#C6C5D0",
        "surfaceContainerLowest": "#0D0E13",
        "surfaceContainerLow": "#1A1B21",
        "surfaceContainer": "#1E1F25",
        "surfaceContainerHigh": "#292A30",
        "surfaceContainerHighest": "#34343B",
        "outline": "#90909A",
        "outlineVariant": "#45464F"
      }
    },
    "semantic": {
      "light": {
        "success": "#1B7F4B",
        "onSuccess": "#FFFFFF",
        "successContainer": "#D2F6DF",
        "onSuccessContainer": "#00391D",
        "warning": "#9A6100",
        "onWarning": "#FFFFFF",
        "warningContainer": "#FFDFB3",
        "onWarningContainer": "#311B00",
        "danger": "#BA1A1A",
        "onDanger": "#FFFFFF",
        "dangerContainer": "#FFDAD6",
        "onDangerContainer": "#410002",
        "info": "#006399",
        "onInfo": "#FFFFFF",
        "infoContainer": "#CDE5FF",
        "onInfoContainer": "#001D32"
      },
      "dark": {
        "success": "#78DC9F",
        "onSuccess": "#00391D",
        "successContainer": "#00522C",
        "onSuccessContainer": "#94F9B9",
        "warning": "#FFB951",
        "onWarning": "#4F2E00",
        "warningContainer": "#704400",
        "onWarningContainer": "#FFDFB3",
        "danger": "#FFB4AB",
        "onDanger": "#690005",
        "dangerContainer": "#93000A",
        "onDangerContainer": "#FFDAD6",
        "info": "#95CCFF",
        "onInfo": "#003352",
        "infoContainer": "#004A75",
        "onInfoContainer": "#CDE5FF"
      },
      "gpuVram": {
        "safeThresholdPercent": 70,
        "warningThresholdPercent": 90,
        "safeRole": "success",
        "warningRole": "warning",
        "criticalRole": "danger"
      },
      "maskCanvas": {
        "backdrop": "#0A0A0C",
        "strokeFill": "#FF3B5C80",
        "strokeBorder": "#FF8FA3CC",
        "cursorRing": "#FFFFFFCC"
      }
    }
  },
  "typography": {
    "pageTitle": {
      "m3Role": "titleLarge",
      "fontSizeSp": 20,
      "lineHeightSp": 28,
      "fontWeight": 600,
      "usage": "TopAppBar 标题、空状态主标题"
    },
    "sectionHeader": {
      "m3Role": "titleSmall",
      "fontSizeSp": 14,
      "lineHeightSp": 20,
      "fontWeight": 600,
      "letterSpacingSp": 0.1,
      "usage": "页面内分组标题（如“提示词”、“运行中任务”、“GPU 状态”），配 primary 或 onSurfaceVariant 色"
    },
    "cardTitle": {
      "m3Role": "titleMedium",
      "fontSizeSp": 16,
      "lineHeightSp": 24,
      "fontWeight": 600,
      "usage": "卡片主标题（服务器名称、工作流名称、参数标签）"
    },
    "bodyPrimary": {
      "m3Role": "bodyMedium",
      "fontSizeSp": 14,
      "lineHeightSp": 20,
      "fontWeight": 400,
      "usage": "卡片正文、输入框内容、说明正文"
    },
    "bodySecondary": {
      "m3Role": "bodySmall",
      "fontSizeSp": 12,
      "lineHeightSp": 16,
      "fontWeight": 400,
      "usage": "次要说明、辅助提示、时间戳"
    },
    "badgeLabel": {
      "m3Role": "labelSmall",
      "fontSizeSp": 11,
      "lineHeightSp": 16,
      "fontWeight": 600,
      "letterSpacingSp": 0.2,
      "usage": "状态徽章（在线/离线/成功/失败/置信度）"
    },
    "codeMono": {
      "fontFamily": "FontFamily.Monospace",
      "fontSizeSp": 12,
      "lineHeightSp": 18,
      "fontWeight": 400,
      "usage": "Prompt ID 短码、节点 ID (#4 · CLIPTextEncode)、URL、文件名、JSON 源码"
    }
  },
  "spacing": {
    "xxs": 4,
    "xs": 6,
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 20,
    "xxl": 24,
    "bottomFabClearance": 96,
    "pagePaddingHorizontal": 16,
    "pagePaddingVertical": 12,
    "cardGap": 12,
    "cardPadding": 16,
    "cardPaddingCompact": 12,
    "sectionGap": 20
  },
  "radius": {
    "xs": 6,
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 24,
    "pill": 999,
    "usage": {
      "primaryCard": "lg (16dp)",
      "nestedSurfaceOrParamCard": "md (12dp)",
      "thumbnail": "sm (8dp)",
      "statusBadge": "pill (999dp)",
      "codeTag": "xs (6dp)"
    }
  },
  "elevation": {
    "level0": 0,
    "level1": 1,
    "level2": 3,
    "level3": 6
  },
  "iconSize": {
    "xs": 14,
    "sm": 16,
    "md": 20,
    "lg": 24,
    "emptyStateHero": 48
  },
  "touchTarget": {
    "minSizeDp": 48
  },
  "motion": {
    "fastMs": 150,
    "standardMs": 220,
    "emphasizedMs": 280,
    "easingStandard": "FastOutSlowInEasing",
    "guidelines": [
      "卡片展开/折叠使用 animateContentSize(tween(220))",
      "历史多选底部栏使用 AnimatedVisibility(slideInVertically + fadeIn, 180ms)",
      "进度条数值更新使用 animateFloatAsState(tween(150))，避免跳变",
      "列表增删使用 Modifier.animateItem()"
    ]
  }
}
